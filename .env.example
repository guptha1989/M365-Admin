# ==============================================================================
# M365 Administration & AI Governance Platform - Environment Configuration (.env.example)
# Copy this file to '.env' and fill in your tenant & provider API credentials.
# ==============================================================================

# 1. Environment Profiling & Execution Mode ('TEST' caps sync at 50, 'PROD' is unconstrained)
ENV=TEST

# 2. Database Tier (SQL Express with SQLite Fallback)
DATABASE_URL=sqlite:///./m365_admin.db
# DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost/M365AdminDB?driver=ODBC+Driver+17+for+SQL+Server

# 3. Security & Application Secrets
SECRET_KEY=CHANGE_THIS_TO_YOUR_32_BYTE_JWT_SECRET_KEY!
ENCRYPTION_KEY=gAAAAABk_CHANGE_THIS_FERNET_KEY_IN_PROD_32_BYTES_=

# 4. Azure APIs & Microsoft 365 Entra ID Credentials
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your_entra_client_secret_here
M365_DEFENDER_API_KEY=your_defender_api_token_here
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# 5. Multi-LLM Provider API Keys & Auto-Switch Failover Priority
LLM_FAILOVER_ORDER=openai,gemini,claude,azure_openai,local,deepseek,groq,cohere,mistral,huggingface
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CLAUDE_API_KEY=sk-ant-api03-yourClaudeKeyHere
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
LOCAL_LLM_URL=http://localhost:11434/v1
DEEPSEEK_API_KEY=sk-deepseek-yourKeyHere
GROQ_API_KEY=gsk_yourGroqKeyHere
COHERE_API_KEY=your_cohere_key_here
MISTRAL_API_KEY=your_mistral_key_here
HUGGINGFACE_API_KEY=hf_yourHuggingFaceTokenHere

# 6. Maps APIs (Google Maps, Azure Maps, Mapbox, OpenStreetMap)
MAPS_API_KEY=your_maps_api_key_here
GOOGLE_MAPS_KEY=your_google_maps_key_here
AZURE_MAPS_KEY=your_azure_maps_subscription_key_here
MAPBOX_ACCESS_TOKEN=pk.yourMapboxTokenHere
OSM_TILE_SERVER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# 7. Messaging & Webhooks
TEAMS_WEBHOOK_URL=https://contoso.webhook.office.com/webhookb2/your-channel-id
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXX
SENDGRID_EMAIL_API_KEY=SG.yourSendgridKeyHere

# 8. Future Custom 3rd-Party API Integration Templates
SERVICENOW_ENDPOINT=https://instance.service-now.com/api/now/table/
SERVICENOW_API_KEY=your_servicenow_auth_token_here
SPLUNK_ENDPOINT=https://splunk.contoso.com:8089/services/search/jobs
SPLUNK_HEC_TOKEN=your_splunk_hec_token_here
DATADOG_API_KEY=your_datadog_api_key_here
